# Template for the secfsdstools configuration.
#
# lti.config.ensure_secfsdstools_cfg() renders this file to <repo>/.secfsdstools.cfg,
# substituting ${PROJECT_ROOT} with the absolute repo path and ${USER_AGENT_EMAIL}
# with the configured email, then points the SECFSDSTOOLS_CFG env var at the result.
#
# The rendered .secfsdstools.cfg is gitignored (it contains machine-absolute paths).
# When LTI_SMOKE=1 the PostUpdateProcesses line is stripped so `lti update` only
# downloads + indexes the raw data and skips the multi-hour standardization pipeline.

[DEFAULT]
DownloadDirectory = ${PROJECT_ROOT}/data/sec/dld
DbDirectory       = ${PROJECT_ROOT}/data/sec/db
ParquetDirectory  = ${PROJECT_ROOT}/data/sec/parquet
UserAgentEmail    = ${USER_AGENT_EMAIL}
AutoUpdate        = False
KeepZipFiles      = False
NoParallelProcessing = False
PostUpdateProcesses = secfsdstools.x_examples.automation.memory_optimized_automation.define_extra_processes

[Filter]
filtered_joined_by_stmt_dir = ${PROJECT_ROOT}/data/sec/automated/_1_by_quarter/_1_filtered_joined_by_stmt
parallelize = True

[Standardizer]
standardized_by_stmt_dir = ${PROJECT_ROOT}/data/sec/automated/_1_by_quarter/_2_standardized_by_stmt

[Concat]
concat_joined_by_stmt_dir       = ${PROJECT_ROOT}/data/sec/automated/_2_all/_1_joined_by_stmt
concat_joined_all_dir           = ${PROJECT_ROOT}/data/sec/automated/_2_all/_2_joined
concat_standardized_by_stmt_dir = ${PROJECT_ROOT}/data/sec/automated/_2_all/_3_standardized_by_stmt
