[Unit]
Description=Publish the daily "undervalued today" snapshot to domalouf.com
Documentation=file://%h/Projects/LongTermInvestments/deploy/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Adjust if the repo is not at ~/Projects/LongTermInvestments:
ExecStart=%h/Projects/LongTermInvestments/deploy/publish-undervalued.sh
# yfinance can stall; don't let a hung run block the next night.
TimeoutStartSec=1800
Nice=10
# The track record can't be rebuilt after the fact. This keeps a second copy outside
# the checkout (safe from a `git clean` or a deleted repo, not from a dead disk);
# lti-track-pull.timer, on another machine, pulls a copy off this one.
Environment=LTI_TRACK_BACKUP=%h/backups/lti-track/
# Optional overrides (see the script header):
# Environment=LTI_TOP_N=20
# Environment=LTI_DEST=%h/site/www/invest/

[Install]
WantedBy=default.target
